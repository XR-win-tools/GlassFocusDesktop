<Application x:Class="GlassFocusDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
	<Application.Resources>

		<!-- 玻璃 pill 按钮 -->
		<Style TargetType="Button" x:Key="GlassButton">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="16,7"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Border x:Name="BgBorder" CornerRadius="16"
                                    Background="#10FFFFFF"
                                    BorderBrush="#40FFFFFF" BorderThickness="1"/>
							<Border CornerRadius="16" IsHitTestVisible="False">
								<Border.Background>
									<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
										<GradientStop Color="#24FFFFFF" Offset="0"/>
										<GradientStop Color="#00FFFFFF" Offset="0.55"/>
									</LinearGradientBrush>
								</Border.Background>
							</Border>
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="BgBorder" Property="Background" Value="#20FFFFFF"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="BgBorder" Property="Background" Value="#30FFFFFF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 圆形玻璃图标按钮 -->
		<Style TargetType="Button" x:Key="GlassIconButton">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Border x:Name="BgBorder" CornerRadius="15"
                                    Background="#0EFFFFFF"
                                    BorderBrush="#3CFFFFFF" BorderThickness="1"/>
							<Border CornerRadius="15" IsHitTestVisible="False">
								<Border.Background>
									<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
										<GradientStop Color="#20FFFFFF" Offset="0"/>
										<GradientStop Color="#00FFFFFF" Offset="0.6"/>
									</LinearGradientBrush>
								</Border.Background>
							</Border>
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="BgBorder" Property="Background" Value="#1EFFFFFF"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="BgBorder" Property="Background" Value="#2CFFFFFF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 玻璃输入框 -->
		<Style TargetType="TextBox" x:Key="GlassTextBox">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="CaretBrush" Value="White"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Grid>
							<Border CornerRadius="14" Background="#0EFFFFFF"
                                    BorderBrush="#3CFFFFFF" BorderThickness="1"/>
							<Border CornerRadius="14" IsHitTestVisible="False">
								<Border.Background>
									<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
										<GradientStop Color="#1CFFFFFF" Offset="0"/>
										<GradientStop Color="#00FFFFFF" Offset="0.6"/>
									</LinearGradientBrush>
								</Border.Background>
							</Border>
							<ScrollViewer x:Name="PART_ContentHost" Margin="14,8"/>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 玻璃复选框（圆形环） -->
		<Style TargetType="CheckBox" x:Key="GlassCheckBox">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<Grid Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
							<Ellipse x:Name="Box" Fill="Transparent"
                                     Stroke="#55FFFFFF" StrokeThickness="1.5"/>
							<Ellipse x:Name="Fill" Fill="#55FFFFFF" Visibility="Collapsed"/>
							<Path x:Name="Check" Data="M 4,9 L 7,12 L 13,5"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stretch="None"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
								<Setter TargetName="Check" Property="Visibility" Value="Visible"/>
								<Setter TargetName="Box" Property="Stroke" Value="#A0FFFFFF"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Box" Property="Stroke" Value="#90FFFFFF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Application.Resources>
</Application>